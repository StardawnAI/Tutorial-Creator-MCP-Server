      "id": "config:assets/chapters.json",
      "type": "config",
      "name": "chapters.json",
      "filePath": "assets/chapters.json",
      "summary": "Default chapter list for split-music.mjs: twenty MM:SS start stamps with track titles that mark where a one-hour ambient music mix is cut into separate background tracks.",
      "tags": ["configuration", "music", "chapters", "data"],
      "complexity": "simple"
    },
    {
      "id": "file:scripts/e2e.mjs",
      "type": "file",
      "name": "e2e.mjs",
      "filePath": "scripts/e2e.mjs",
      "summary": "End-to-end check of the whole recording pipeline without MCP. It records short tutorials against local test pages, then asserts duration, a non-black picture, the audio mix and loudness, caption timing, the avatar bubble, motion cards, two-browser switching and a bot login with two-factor (TOTP) codes.",
      "tags": ["test", "e2e", "entry-point", "video-pipeline", "audio"],
      "complexity": "complex",
      "languageNotes": "Plain ESM script that imports the compiled dist/lib/*.js output rather than the TypeScript sources, so it needs a build first; ffmpeg is used both to produce synthetic narration and to measure the result."
    },
    {
      "id": "function:scripts/e2e.mjs:speechStandIn",
      "type": "function",
      "name": "speechStandIn",
      "filePath": "scripts/e2e.mjs",
      "lineRange": [65, 77],
      "summary": "Generates a synthetic narration clip with ffmpeg (quiet, slowly swelling pink noise plus one sharp transient), so the mixing chain is tested without a speech API key and with speech-like loudness properties.",
      "tags": ["test-fixture", "audio", "ffmpeg"],
      "complexity": "simple"
    },
    {
      "id": "function:scripts/e2e.mjs:loudnessOf",
      "type": "function",
      "name": "loudnessOf",
      "filePath": "scripts/e2e.mjs",
      "lineRange": [80, 90],
      "summary": "Measures the integrated loudness of a time window of a rendered file with ffmpeg, used to assert that the voice sits above the music.",
      "tags": ["audio", "measurement", "ffmpeg", "assertion"],
      "complexity": "simple"
    },
