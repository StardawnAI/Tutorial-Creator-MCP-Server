      "id": "file:src/cli/login.ts",
      "type": "file",
      "name": "login.ts",
      "filePath": "src/cli/login.ts",
      "summary": "One-time sign-in CLI (`npm run login`) that opens a visible browser on a named tutorial profile so the user can log in by hand; the stored session is then reused by every later headless recording.",
      "tags": ["entry-point", "cli", "authentication", "browser-profile"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/cli/login.ts:parseArgs",
      "type": "function",
      "name": "parseArgs",
      "filePath": "src/cli/login.ts",
      "lineRange": [18, 28],
      "summary": "Parses `--url` and `--profile` command-line flags for the login command.",
      "tags": ["cli", "argument-parsing", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:src/cli/login.ts:main",
      "type": "function",
      "name": "main",
      "filePath": "src/cli/login.ts",
      "lineRange": [40, 78],
      "summary": "Loads config, launches a headed persistent browser on the chosen profile, navigates to the target URL, waits for the user to press Enter after signing in, then reports the visited pages and closes the context so the session persists.",
      "tags": ["entry-point", "cli", "authentication", "interactive"],
      "complexity": "moderate"
    },
    {
      "id": "file:src/lib/browser.ts",
      "type": "file",
      "name": "browser.ts",
      "filePath": "src/lib/browser.ts",
      "summary": "Owns the Playwright browser lifecycle: launches a persistent Chromium context from a profile directory (or a throwaway temp profile), applies anti-throttling and anti-automation flags, hides headless traces, and installs the repaint heartbeat on every page.",
      "tags": ["service", "browser-automation", "playwright", "recording"],
      "complexity": "moderate",
      "languageNotes": "Uses Playwright's launchPersistentContext plus a CDP session (Network.setUserAgentOverride) to rewrite the HeadlessChrome user agent per page."
    },
    {
      "id": "function:src/lib/browser.ts:disguiseScript",
