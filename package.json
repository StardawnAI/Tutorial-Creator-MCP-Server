{
  "name": "tutorial-creator-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that records narrated screen-capture tutorial videos of web apps, using a logged-in Playwright browser, ElevenLabs narration and ffmpeg compositing.",
  "type": "module",
  "bin": {
    "tutorial-creator-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "login": "node dist/cli/login.js",
    "doctor": "node dist/cli/doctor.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.62.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tutorial",
    "screen-recording",
    "playwright",
    "elevenlabs",
    "ffmpeg"
  ],
  "license": "MIT"
}
